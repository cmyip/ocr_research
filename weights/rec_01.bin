######## Singapore ####################################################################################################
$1187
# secondary x 256 + primary: 1*256+2
TrainingGroup:2

# Replacements
^5%L~^S%L
^S0%L%D%D%D%D%L~^SQ%L%D%D%D%D%L
^S%L0%D%D%D%L~^S%LQ%D%D%D%L
^S%L0%D%D%D%D%L~^S%LQ%D%D%D%D%L
^SB5%D%D%D%D%L~^SBS%D%D%D%D%L
^SM8%D%D%D%D%L~^SMB%D%D%D%D%L
^S6%D%D%D%D%L~^SG%D%D%D%D%L

M1D$~MID$

# Checksum letter
CHECKSUMLETTER=%L^F^N^Q^V^W

# 1- S � Vehicle class BA � Alphabetical series ("I" and "O" are not used to avoid confusion with "1" and "0")
# 2- 1234 � Numerical series 
# 3- A � Checksum letter ("F", "I", "N", "O", "Q", "V" and "W" are never used as checksum letters; 
#        absent on special government vehicle plates and events vehicle plates)
# Taxis, Off-Peak, Vintage...
S%L[%L,%0]%D[%D,%0][%D,%0][%D,%0]%{CHECKSUMLETTER}
SH[%L,%0]%D%D%D%D%{CHECKSUMLETTER}
[A,E][%L,%0]%D[%D,%0][%D,%0][%D,%0]%{CHECKSUMLETTER}
S%D%D[%D,%0][%D,%0]%{CHECKSUMLETTER}
EX%D[%D,%0]%{CHECKSUMLETTER}

# Special prefix for the first 100 locally assembled
EVS%D[%D,%0][%D,%0][%D,%0]%{CHECKSUMLETTER}

# Motorcycles 
F%L[%L,%0]%D[%D,%0][%D,%0][%D,%0]%{CHECKSUMLETTER}
LTA%D[%D,%0][%D,%0][%D,%0]%{CHECKSUMLETTER}

# Light Goods vehicles
G%L[%L,%0]%D[%D,%0][%D,%0][%D,%0]%{CHECKSUMLETTER}

# Private buses
[PA,PB,PC,PD,PH,PZ]%D[%D,%0][%D,%0][%D,%0]%{CHECKSUMLETTER}

# Public buses
SBS%D%D%D[%D,%0]%{CHECKSUMLETTER}
SG%D%D%D[%D,%0]%{CHECKSUMLETTER}

# School buses
CB%D%D%D[%D,%0]%{CHECKSUMLETTER}

# Pulau Ubin Vehicle
PU%D%D[%D,%0]%{CHECKSUMLETTER}

# Engineering plant vehicles and very heavy goods vehicles
[W,X,TR,Y]%L%D%D[%D,%0][%D,%0]%{CHECKSUMLETTER}

# Consular and diplomatic
S%D%D%D[%D,%0]C[C,D]

# controlled for specific types of vehicle

#  Singapore Armed Forces vehicles
%D%D%D%D[%D,%0]MID
Q[X,Y]%D%D%D[%D,%0]%{CHECKSUMLETTER}
S%D%D%D%D[CC,CD,TE]
TP%D%D%D%D%{CHECKSUMLETTER}

# Restricted vehicles and R&D Vehicles
R[U,D]%D%D%D%D%L

# Government
SEP1
SPF1

# City Shuttle Service buses
CSS%D%D%D[%D,%0]%{CHECKSUMLETTER}






